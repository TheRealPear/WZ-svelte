{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "warzone-website",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-11-18",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"CF_PAGES": "1"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	}
}